; Engine configuration file.
; docs/18_SPIKE_EXECUTION_PLAN.md Kart 5: minimum Godot 4 .NET proje kabuğu.

config_version=5

[application]

config/name="Football Career Simulator - Presentation Shell"
run/main_scene="res://Shell.tscn"
