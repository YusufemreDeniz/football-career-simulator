<Project>

  <!--
    Ortak proje ayarları (docs/17_TECHNOLOGY_AND_ARCHITECTURE_DECISION.md Bölüm 6.4 ve Bölüm 8 ile uyumlu).
    TargetFramework burada net9.0 olarak kullanılmaktadır ve altı spike'ın tamamında (headless
    simulation, determinizm, SQLite, Godot editör/headless çalıştırma, Godot Windows export dahil)
    sorunsuz doğrulanmıştır. Exact SDK 9.0.317 ve latestPatch politikası D-384 ile pinlenmiştir;
    Godot Android uyumluluğu nedeniyle önceki net10.0 kararı geçersiz kılınmıştır.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
